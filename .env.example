# =============================================================================
# Ouroboros Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# ---- LLM Provider (Required) ----
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# OpenAI (alternative): https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key

# ---- WeChat Work Bot (Optional) ----
# Get these from: 企业微信管理后台 → 应用管理 → 自建应用
# WECHAT_TOKEN=your-token
# WECHAT_ENCODING_AES_KEY=your-43-char-aes-key
# WECHAT_CORP_ID=your-corp-id
# WECHAT_AGENT_ID=your-agent-id
# WECHAT_SECRET=your-app-secret
# WECHAT_PORT=9878
